# Dependency Time Machine — environment reference.
# Copy to .env (or export in your shell/CI). No value here is a secret;
# secret-bearing vars are intentionally left EMPTY — empty means "feature disabled".
# Never commit a .env file with credentials in it.

# --- Data layer -----------------------------------------------------------
# sqlite (default, local dev) | postgres | memory (tests/ephemeral)
DTM_DATA_DRIVER=sqlite
DTM_SQLITE_PATH=./data/dtm.sqlite
# Only used when DTM_DATA_DRIVER=postgres:
DTM_DATABASE_URL=postgres://dtm:change-me@127.0.0.1:5432/dtm?sslmode=disable

# --- HTTP -------------------------------------------------------------------
DTM_HTTP_ADDR=127.0.0.1:8080
DTM_LOG_LEVEL=INFO
# Optional: serve a prebuilt frontend/dist at / when set.
DTM_STATIC_DIR=

# Public API rate limit (token bucket per client IP).
DTM_RATE_LIMIT_RPS=10
DTM_RATE_LIMIT_BURST=20

# Optional build-time version marker (normally set via -ldflags); default "dev".
DTM_VERSION=

# --- Execution isolation ----------------------------------------------------
# auto = container if a docker runtime is detected, else safe degraded mode.
# container = require docker, fail otherwise. degraded = manifest/graph level
# only; no repository code is ever executed on the control-plane host.
DTM_RUNNER_MODE=auto
DTM_DOCKER_IMAGE=ghcr.io/ensembyte/dtm-runner:1.0.0
# Base/candidate equivalence is enforced from these shared limits.
DTM_RUNNER_CPU_LIMIT=2
DTM_RUNNER_MEMORY_LIMIT=4g
DTM_RUNNER_DISK_LIMIT=10g
DTM_RUNNER_WALL_CLOCK_LIMIT=1800s
# Test/CI knob: set to 1 to force degraded mode even when docker is present
# (skips the docker probe in auto mode). Default: unset.
DTM_DISABLE_DOCKER_PROBE=

# --- Security / advisories ---------------------------------------------------
DTM_OSV_ENDPOINT=https://api.osv.dev/v1
# When false, only the bundled offline advisory dataset is used and findings
# are labelled "advisory_feed_unreachable" — advisories are never fabricated.
DTM_ENABLE_ONLINE_ADVISORIES=true
DTM_ARTIFACT_RETENTION_DAYS=14

# --- GitHub integration (all optional in MVP; empty = feature disabled) ------
# Optional GitHub token used for advisory / release-note fetches against the
# PUBLIC GitHub endpoints only. No token is required for the bundled offline
# advisory dataset (offline fallback works with it unset). Never store a real
# token in this file or commit it. Empty = check-run posting is skipped
# ("skipped_no_token"), no fake success.
DTM_GITHUB_TOKEN=
# Webhook HMAC verification key:
DTM_GITHUB_WEBHOOK_SECRET=
DTM_GITHUB_APP_ID=
DTM_GITHUB_APP_PRIVATE_KEY_FILE=
